{{>partials/header}}

<h1 class="mb-4 text-center">{{title}}</h1>
<p class="text-center mb-5">Welcome, {{user}}. Manage your classes below.</p>

<!-- Add New Course -->
<div class="card mb-5">
  <div class="card-header bg-primary text-white">Add New Course</div>
  <div class="card-body">
    <form method="POST" action="/dashboard/add" class="row g-3">
      <div class="col-md-6">
        <label class="form-label">Name:</label>
        <input name="name" class="form-control" required>
      </div>
      <div class="col-md-6">
        <label class="form-label">Duration:</label>
        <input name="duration" class="form-control" required>
      </div>
      <div class="col-md-6">
        <label class="form-label">Schedule:</label>
        <input name="schedule" class="form-control" required>
      </div>
      <div class="col-md-6">
        <label class="form-label">Location:</label>
        <input name="location" class="form-control" required>
      </div>
      <div class="col-md-6">
        <label class="form-label">Price:</label>
        <input name="price" class="form-control" required>
      </div>
      <div class="col-12">
        <label class="form-label">Description:</label>
        <textarea name="description" class="form-control" rows="2" required></textarea>
      </div>
      <div class="col-12 text-end">
        <button type="submit" class="btn btn-success">Add Course</button>
      </div>
    </form>
  </div>
</div>

<!-- Course List -->
<h2 class="mb-3">All Courses</h2>
{{#courses}}
  <div class="card mb-4">
    <div class="card-body">
      <h5 class="card-title">{{name}}</h5>
      <p><strong>Schedule:</strong> {{schedule}} | <strong>Location:</strong> {{location}} | <strong>Price:</strong> £{{price}}</p>

      <div class="d-flex flex-wrap gap-2 mt-3">
        <form method="POST" action="/dashboard/delete/{{_id}}">
          <button type="submit" class="btn btn-outline-danger btn-sm">Delete</button>
        </form>

        <form action="/dashboard/edit/{{_id}}">
          <button type="submit" class="btn btn-outline-secondary btn-sm">Edit</button>
        </form>

        <form action="/dashboard/bookings/{{_id}}">
          <button type="submit" class="btn btn-outline-primary btn-sm">View Bookings</button>
        </form>
      </div>
    </div>
  </div>
{{/courses}}

{{^courses}}
  <div class="alert alert-warning">No courses found.</div>
{{/courses}}

<!-- User and Organiser Management -->
<div class="mt-5">
  <h2>Manage Users</h2>
  <div class="d-flex gap-3 flex-wrap">
    <a href="/dashboard/organisers" class="btn btn-outline-secondary">View Organisers</a>
    <a href="/dashboard/users" class="btn btn-outline-secondary">View Registered Members</a>
  </div>
</div>

{{>partials/footer}}
