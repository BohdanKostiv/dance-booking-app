{{>partials/header}}

<h1 class="mb-4 text-center">{{title}}</h1>

{{#users}}
  <div class="card mb-3">
    <div class="card-body d-flex justify-content-between align-items-center">
      <strong>{{user}}</strong>
      <form method="POST" action="/dashboard/delete-user/{{user}}">
        <button type="submit" class="btn btn-sm btn-outline-danger">Delete User</button>
      </form>
    </div>
  </div>
{{/users}}

{{^users}}
  <div class="alert alert-info text-center">No registered users found.</div>
{{/users}}

<a href="/dashboard" class="btn btn-secondary mt-4">← Back to Dashboard</a>

{{>partials/footer}}
