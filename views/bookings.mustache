{{>partials/header}}

<h1 class="mb-4 text-center">{{title}}</h1>

{{#bookings}}
  <div class="card mb-4">
    <div class="card-body">
      <p class="mb-1"><strong>Name:</strong> {{name}}</p>
      <p class="mb-1"><strong>Date:</strong> {{date}}</p>
      <form method="POST" action="/dashboard/delete-booking/{{_id}}" class="mt-2">
        <input type="hidden" name="courseId" value="{{courseId}}">
        <button type="submit" class="btn btn-sm btn-outline-danger">Delete Booking</button>
      </form>
    </div>
  </div>
{{/bookings}}

{{^bookings}}
  <div class="alert alert-info text-center">No bookings found for this course yet.</div>
{{/bookings}}

<a href="/dashboard" class="btn btn-secondary mt-3">← Back to Dashboard</a>

{{>partials/footer}}
