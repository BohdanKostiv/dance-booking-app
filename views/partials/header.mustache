      <div class="d-flex">
        <ul class="navbar-nav">
          <li class="nav-item"><a class="nav-link text-dark" href="/">Home</a></li>
          <li class="nav-item"><a class="nav-link text-dark" href="/courses">Courses</a></li>
          <li class="nav-item"><a class="nav-link text-dark" href="/about">About</a></li>

          {{#isUser}}
            <li class="nav-item"><a class="nav-link text-dark" href="/my-bookings">My Bookings</a></li>
