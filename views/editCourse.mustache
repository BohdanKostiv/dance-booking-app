{{>partials/header}}

<h1 class="mb-4 text-center">{{title}}</h1>

<div class="card mx-auto" style="max-width: 600px;">
  <div class="card-body">
    <form method="POST" action="/dashboard/edit/{{course._id}}">
      <div class="mb-3">
        <label class="form-label">Name:</label>
        <input name="name" class="form-control" value="{{course.name}}" required>
      </div>
      <div class="mb-3">
        <label class="form-label">Duration:</label>
        <input name="duration" class="form-control" value="{{course.duration}}" required>
      </div>
      <div class="mb-3">
        <label class="form-label">Schedule:</label>
        <input name="schedule" class="form-control" value="{{course.schedule}}" required>
      </div>
      <div class="mb-3">
        <label class="form-label">Location:</label>
        <input name="location" class="form-control" value="{{course.location}}" required>
      </div>
      <div class="mb-3">
        <label class="form-label">Price:</label>
        <input name="price" class="form-control" value="{{course.price}}" required>
      </div>
      <div class="mb-3">
        <label class="form-label">Description:</label>
        <textarea name="description" class="form-control" rows="3">{{course.description}}</textarea>
      </div>
      <div class="d-grid">
        <button type="submit" class="btn btn-primary">Save Changes</button>
      </div>
    </form>
  </div>
</div>

<a href="/dashboard" class="btn btn-secondary mt-4">← Back to Dashboard</a>

{{>partials/footer}}
